; Hood JRPG — engine version pinned per DEC-011.
config_version=5

[application]
config/name="Hood JRPG"
run/main_scene="res://scenes/field/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
EventBus="*res://autoloads/event_bus.gd"
GameState="*res://autoloads/game_state.gd"
SceneManager="*res://autoloads/scene_manager.gd"
AudioManager="*res://autoloads/audio_manager.gd"
SaveSystem="*res://autoloads/save_system.gd"

[debug]
gdscript/warnings/untyped_declaration=2

[rendering]
renderer/rendering_method="gl_compatibility"
