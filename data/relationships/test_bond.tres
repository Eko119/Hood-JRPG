[gd_resource type="Resource" script_class="RelationshipDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/definitions/relationship_definition.gd" id="1"]
[ext_resource type="Script" path="res://systems/definitions/relationship_tier.gd" id="2"]
[ext_resource type="Resource" path="res://data/abilities/test_cover.tres" id="3"]

[sub_resource type="Resource" id="t0"]
script = ExtResource("2")
